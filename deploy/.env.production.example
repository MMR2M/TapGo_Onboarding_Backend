TAPGO_IMAP_HOST=mail.infomaniak.com
TAPGO_IMAP_PORT=993
TAPGO_IMAP_USERNAME=contract@tapgo.ch
TAPGO_IMAP_PASSWORD=ENTER_ON_SERVER_ONLY

TAPGO_OBJECT_STORAGE_BUCKET=CONFIRM_EXACT_BUCKET_NAME
