TAPGO_ENV=production
TAPGO_BASE_URL=https://contract.tapgo.ch
TAPGO_HEALTH_TOKEN=GENERATE_A_LONG_RANDOM_VALUE

TAPGO_INTERNAL_EMAIL=contract@tapgo.ch
