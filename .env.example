TAPGO_INTERNAL_EMAIL=contract@tapgo.ch
TAPGO_FROM_EMAIL=noreply@tapgo.local
TAPGO_BASE_URL=http://localhost:8000
TAPGO_ENV=development
TAPGO_HEALTH_TOKEN=

# Email delivery
TAPGO_SMTP_HOST=
TAPGO_SMTP_PORT=587
TAPGO_SMTP_USERNAME=
TAPGO_SMTP_PASSWORD=
TAPGO_SMTP_STARTTLS=true
TAPGO_IMAP_HOST=
TAPGO_IMAP_PORT=993
TAPGO_IMAP_USERNAME=
TAPGO_IMAP_PASSWORD=

# Object storage
TAPGO_OBJECT_STORAGE_BUCKET=
TAPGO_OBJECT_STORAGE_ENDPOINT=
TAPGO_OBJECT_STORAGE_ACCESS_KEY=
TAPGO_OBJECT_STORAGE_SECRET_KEY=
TAPGO_OBJECT_STORAGE_REGION=ch-dk-2
TAPGO_OBJECT_STORAGE_BASE_URL=

# Stripe checkout
TAPGO_STRIPE_SECRET_KEY=
TAPGO_STRIPE_WEBHOOK_SECRET=
TAPGO_STRIPE_CURRENCY=chf

# PDF generation: chrome, libreoffice, or stub
TAPGO_PDF_ENGINE=chrome
TAPGO_CHROME_BIN=/usr/bin/google-chrome
